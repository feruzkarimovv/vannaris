.env
.env.*
!.env.example
.DS_Store

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Raw vendor responses are stored locally but never committed — publishing
# vendor content (as opposed to derived scores) is what docs/03 warns against.
data/raw/
*.db
*.sqlite3

# The active held-out question set. Its hash is committed
# (src/queries/heldout/manifest.json) before it ever runs and its questions are
# published in full when it retires; while it is live, the text staying out of
# git is the entire point. CI writes it here from an Actions secret.
data/heldout/

# Tool caches.
.impeccable/

# Site checks use jsdom, installed ad hoc rather than as a project dependency —
# this stays a Python repo with a static site, not a Node project.
node_modules/

# Calibration tasks show the vendors' actual retrieved content to the labeller.
# docs/03: retrieved content is stored for reproducibility, never republished.
calibration/
.vercel
.env*

# Offline demos and local verification artifacts are never measurements.
.demo/
.cache/
.artifacts/
run-status.json
*.p7m
